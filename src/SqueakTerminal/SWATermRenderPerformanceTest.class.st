SWATermRenderPerformanceTest >> testRenderWithCaskaydiaMono [
	| font |
	font := TTCFont familyName: 'CaskaydiaMonoNFM' pointSize: SWATermMorph defaultFontSize.
	(font notNil and: [ font familyName = 'CaskaydiaMonoNFM' ]) ifFalse: [ ^ self skip: 'Caskaydia Mono is not installed' ].
	self assertFastWith: font.
