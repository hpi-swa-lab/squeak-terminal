{
	#category : #running,
	#'squeak_changestamp' : 'MCPServer (jl) 11/10/2026 14:01'
}
SWATermRenderPerformanceTest >> assertFastWith: aFont [
	| times |
	aFont flushCache.
	times := self millisecondsPerFrameWith: aFont.
	self
		assert: times first < 500
		description: aFont printString, ' took ', times first printString, ' ms for the first 80x24 frame'.
	self
		assert: times second < 100
		description: aFont printString, ' took ', times second printString, ' ms per 80x24 frame'.
	self
		assert: ((aFont instVarNamed: 'colorToCacheMap') allSatisfy: [ :cache | cache size < 1000 ])
		description: 'A glyph cache per colour with one slot per codepoint: 7.7 MB per colour for a Nerd Font'.
]

{
	#category : #running,
	#'squeak_changestamp' : 'MCPServer (jl) 11/9/2026 18:51'
}
SWATermRenderPerformanceTest >> captureCells [
	| lines |
	lines := self class opencodeVoiceOrbCapture lines allButFirst.
	^ lines collect: [ :line |
		(line subStrings: ' ') collect: [ :field | | words cell |
			words := (field subStrings: ',') collect: [ :hex | Integer readFrom: hex base: 16 ].
			cell := SWATermCell new.
			cell ch0: words first; widthWord: (words at: 2); attrsWord: (words at: 3);
				fgWord: (words at: 4); bgWord: (words at: 5).
			cell ] ]
]

{
	#category : #running,
	#'squeak_changestamp' : 'MCPServer (jl) 11/10/2026 14:01'
}
SWATermRenderPerformanceTest >> millisecondsPerFrameWith: aFont [
	"The first frame, which fills the glyph caches, and the average of five after it."
	| cells form canvas first frames |
	morph font: aFont.
	cells := self captureCells.
	form := Form extent: (80 * (aFont widthOf: $m)) @ (24 * aFont height) depth: 32.
	canvas := form getCanvas.
	first := [ self render: cells on: canvas ] timeToRun.
	frames := 5.
	^ { first. ([ frames timesRepeat: [ self render: cells on: canvas ] ] timeToRun) / frames }
]

{
	#category : #running,
	#'squeak_changestamp' : 'MCPServer (jl) 11/9/2026 18:51'
}
SWATermRenderPerformanceTest >> render: cells on: aCanvas [
	aCanvas fillRectangle: aCanvas form boundingBox color: Color black.
	cells doWithIndex: [ :rowCells :row |
		rowCells doWithIndex: [ :cell :col |
			morph drawCell: cell row: row - 1 col: col - 1 origin: 0 @ 0 on: aCanvas ] ]
]

